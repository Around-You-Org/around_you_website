{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "around-you",
  "compatibility_date": "2026-06-01",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}